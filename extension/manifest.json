{
  "manifest_version": 3,
  "name": "Menos odio a la vista",
  "short_name": "Menos odio",
  "version": "0.1.0",
  "description": "Oculta comentarios con odio en español usando el modelo A3 (RoBERTuito) del proyecto. Muestra el puntaje del modelo.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Menos odio a la vista",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.hf.space/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sites.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
